{
  "info": {
    "_postman_id": "37e2ec77-7303-4558-bd9e-19f3d3aaac31",
    "name": "UNO R4 Multi-Service Health Checker API",
    "description": "API collection for the UNO R4 WiFi multi-service health checker. Every endpoint is served under /api/v<version>/, where the version comes from src/UNO_R4_Health_Checker/.version.\n\nSelect the \"UNO R4 Health Checker\" environment (test/UNO_R4_Health_Checker.postman_environment.json) and set baseUrl, apiVersion, serviceId, deviceNumber, and apiToken there. GET requests need no token; POST requests send apiToken as a bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Get Device Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/status",
            "description": "Device, Wi-Fi, alarm, certificate, and watchdog summary, including api_version.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API version matches apiVersion', function () {",
                  "  pm.expect(pm.response.json().api_version).to.eql(Number(pm.variables.get('apiVersion')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/services",
            "description": "All services with their state, including the resource number.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Get One Service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/services/{{serviceId}}",
            "description": "One service by its id.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checks",
      "item": [
        {
          "name": "Queue All Checks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/check",
            "description": "Queue a health check and a certificate read of every enabled service. Answers 202."
          },
          "response": []
        },
        {
          "name": "Queue One Service Check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/services/{{serviceId}}/check",
            "description": "Queue a health check and a certificate read of one service. Answers 202, or 409 when the service is disabled."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Buzzer",
      "item": [
        {
          "name": "SOS Alert Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/alert",
            "description": "Play the service alarm signal (SOS) once, even while the buzzer is silenced."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Alert test started', function () {",
                  "  pm.expect(pm.response.json().result).to.eql('Alert test started');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "SOS Alert Test for Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/alert/{{deviceNumber}}",
            "description": "Play the SOS followed by the counted beeps of one device number (1 to 5) once."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Alert test started', function () {",
                  "  pm.expect(pm.response.json().result).to.eql('Alert test started');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Certificate Expiry Alert Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/crtexp",
            "description": "Play the certificate warning melody once, even while the buzzer is silenced."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Alert test started', function () {",
                  "  pm.expect(pm.response.json().result).to.eql('Alert test started');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Certificate Expiry Alert Test for Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/crtexp/{{deviceNumber}}",
            "description": "Play the certificate warning melody followed by the counted beeps of one device number (1 to 5) once."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Alert test started', function () {",
                  "  pm.expect(pm.response.json().result).to.eql('Alert test started');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Silence Buzzer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/silence",
            "description": "Silence the current alarm until a new fault appears."
          },
          "response": []
        },
        {
          "name": "Unsilence Buzzer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Length",
                "value": "0"
              }
            ],
            "url": "{{baseUrl}}/api/v{{apiVersion}}/buzzer/unsilence",
            "description": "Re-enable the alarm sound."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Successful API response', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  }
}
